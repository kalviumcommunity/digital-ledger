generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SHOPKEEPER
  EMPLOYEE
}

model User {
  id               Int        @id @default(autoincrement())
  name             String?
  email            String     @unique
  mobile           String     @unique
  password         String
  role             Role       @default(SHOPKEEPER)
  shopkeeperId     Int?
  shopkeeper       User?      @relation("ShopkeeperEmployees", fields: [shopkeeperId], references: [id], onDelete: Cascade)
  employees        User[]     @relation("ShopkeeperEmployees")
  customers        Customer[] @relation("ShopCustomers")
  createdCustomers Customer[] @relation("CustomerCreatedBy")
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt
}

model Customer {
  id           Int           @id @default(autoincrement())
  name         String
  phone        String
  email        String?
  address      String?
  userId       Int
  user         User          @relation("ShopCustomers", fields: [userId], references: [id], onDelete: Cascade)
  createdById  Int?
  createdBy    User?         @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  @@index([userId])
}

enum TransactionType {
  GIVE
  GOT
}

model Transaction {
  id          Int             @id @default(autoincrement())
  amount      Float
  type        TransactionType
  description String?
  date        DateTime        @default(now())
  customerId  Int
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  auditLogs   AuditLog[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  @@index([customerId])
}

model AuditLog {
  id            Int          @id @default(autoincrement())
  action        String
  details       String?
  transactionId Int?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@index([transactionId])
}