datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

/// User Roles:
/// - SHOPKEEPER: Full owner of their ledger, customers, and financial records.
/// - EMPLOYEE: Staff member assisting with transaction entries.
enum Role {
  SHOPKEEPER
  EMPLOYEE
}

/// Financial Transaction Types:
/// - CREDIT: Money or goods given by the shopkeeper to the customer on credit (increases amount due / receivable).
/// - DEBIT: Payment received by the shopkeeper from the customer (decreases amount due / clears balance).
enum TransactionType {
  CREDIT
  DEBIT
}

/// Audit Log Action Types:
/// Tracks the full lifecycle of every transaction for accountability and anti-fraud.
enum ActionType {
  CREATE
  EDIT
  DELETE
}

/// User Account Model (Tenant Boundary):
/// Represents an authenticated shopkeeper or employee.
/// All customers and ledgers are strictly scoped to a User ID to guarantee data isolation between shopkeepers.
model User {
  id        String     @id @default(uuid())
  email     String     @unique
  name      String
  password  String     // Bcrypt hashed password (never stored in plaintext)
  role      Role       @default(SHOPKEEPER)
  customers Customer[] // 1-to-many: Shopkeeper has many customers
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// Customer Model:
/// Represents a buyer or borrower associated with a specific shopkeeper.
model Customer {
  id        String     @id @default(uuid())
  userId    String     // Foreign key pointing to User (multi-tenant isolation)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  ledger    Ledger?    // 1-to-1: Each customer has exactly one financial ledger account
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

/// Ledger Model (Financial Account Accumulator):
/// Tracks the running balance for a specific customer.
/// Maintaining totalBalance on the ledger allows instant balance queries without summing thousands of rows each time.
model Ledger {
  id           String        @id @default(uuid())
  customerId   String        @unique // Strict 1-to-1 relation with Customer
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  totalBalance Decimal       @default(0.00) @db.Decimal(12, 2) // Running net balance (Credit - Debit)
  transactions Transaction[] // 1-to-many: Ledger contains chronological transaction entries
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// Transaction Model:
/// An individual financial entry representing credit given or payment collected.
/// Uses optimistic concurrency locking (version) and soft-deletion (isDeleted).
model Transaction {
  id        String          @id @default(uuid())
  ledgerId  String          // Belongs to a customer's ledger
  ledger    Ledger          @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  type      TransactionType // CREDIT or DEBIT
  amount    Decimal         @db.Decimal(12, 2)
  note      String?         // Optional description or invoice notes
  method    String          @default("Cash") // Cash, UPI, Bank Transfer, Card, etc.
  version   Int             @default(1) // Incremented on every edit to prevent conflicting overwrites
  isDeleted Boolean         @default(false) // Soft deletion preserves audit history

  // Concurrent Editing Protection:
  // Allows a user to lock a row while actively editing in the UI modal
  lockedBy  String?
  lockedAt  DateTime?

  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  auditLogs AuditLog[]      // Complete historical audit trail for this transaction

  @@index([ledgerId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/// Audit Log Model:
/// Immutable record of who modified a transaction, what values changed, and when.
model AuditLog {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  action        ActionType  // CREATE, EDIT, or DELETE
  oldData       Json?       // Snapshot of fields before change
  newData       Json?       // Snapshot of fields after change
  actorId       String      // ID of the user who performed the operation
  timestamp     DateTime    @default(now())

  @@index([transactionId, timestamp(sort: Desc)])
}

/// OTP Types for Email Verification:
enum OtpType {
  SIGNUP
  FORGOT_PASSWORD
}

/// Ephemeral OTP Verification Model:
/// Stores short-lived (10-minute) one-time passwords for secure registration and password resets.
model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String   // 6-digit numeric verification code
  type      OtpType  // SIGNUP or FORGOT_PASSWORD
  expiresAt DateTime // TTL timestamp after which OTP is rejected
  createdAt DateTime @default(now())

  @@index([email, type])
}