# ==============================================
# DATABASE CONFIGURATION (Prisma & PostgreSQL)
# ==============================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Supabase Pooler format (IPv4): postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/digital_ledger?schema=public"

# ==============================================
# AUTHENTICATION (NextAuth.js & Session)
# ==============================================
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-secret-key-here"
SESSION_SECRET="your-32-character-secret-key-here"
# In production (e.g. on Render), set this to your live URL:
# NEXTAUTH_URL="https://digital-ledger-tu7k.onrender.com"
NEXTAUTH_URL="http://localhost:3000"

# ==============================================
# APPLICATION SETTINGS
# ==============================================
NODE_ENV="development"
# In production: NEXT_PUBLIC_APP_URL="https://digital-ledger-tu7k.onrender.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================
# EMAIL DELIVERY (Gmail SMTP for Real OTP Delivery)
# ==============================================
# To send real OTP verification emails to users via Gmail:
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password: https://myaccount.google.com/apppasswords
#    - Select App name: KhataBook
#    - Google will display a 16-character code (e.g. "abcd efgh ijkl mnop")
# 3. Enter your Gmail and App Password below:
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-character-app-password"

# Optional standard SMTP fallback settings (if not using Gmail directly):
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-16-character-app-password"
# SMTP_FROM="\"KhataBook\" <your-email@gmail.com>"

# ==============================================
# HTTP EMAIL APIS (Optional for Free Cloud Hosting like Render)
# ==============================================
# Render Free Tier blocks outbound SMTP (ports 25, 465, 587).
# To send real emails from Render free tier, add either of these HTTPS API keys:
# RESEND_API_KEY="re_..."
# BREVO_API_KEY="xkeysib-..."