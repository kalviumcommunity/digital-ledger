# ==============================================
# DATABASE CONFIGURATION (Prisma & PostgreSQL)
# ==============================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Supabase Pooler format (IPv4): postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/digital_ledger?schema=public"

# ==============================================
# AUTHENTICATION (NextAuth.js & Session)
# ==============================================
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-secret-key-here"
SESSION_SECRET="your-32-character-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# ==============================================
# APPLICATION SETTINGS
# ==============================================
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"